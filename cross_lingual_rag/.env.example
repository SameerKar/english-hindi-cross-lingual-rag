# Generation Provider (gemini | openai | local | mock)
GENERATION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI Provider (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Translation Provider (deep-translator | gemini | openai | mock)
TRANSLATION_PROVIDER=deep-translator
TRANSLATION_MODEL=

# Optional local model endpoint/runtime (e.g., Ollama)
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=

# Server & App Settings
APP_HOST=127.0.0.1
APP_PORT=8000
